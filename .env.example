# Environment Variables Example for NextTransit
GEMINI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated CORS allowed origins whitelist (e.g. http://localhost:5173,https://app.nexttransit.io)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Real Telematics Integration (Flespi / Wialon Middleware)
FLESPI_API_TOKEN=your_flespi_rest_api_token_here
FLESPI_WEBHOOK_SECRET=your_shared_webhook_secret_here
FLESPI_API_BASE_URL=https://flespi.io
