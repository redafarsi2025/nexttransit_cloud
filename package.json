{
  "name": "nexttransit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx --env-file=.env server.ts",
    "dev:worker": "tsx --env-file=.env worker.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --define:import.meta.env=process.env --log-level=error --packages=external --sourcemap --outfile=dist/server.cjs && esbuild worker.ts --bundle --platform=node --format=cjs --define:import.meta.env=process.env --log-level=error --packages=external --sourcemap --outfile=dist/worker.cjs",
    "start": "node --env-file=.env dist/server.cjs",
    "start:worker": "node --env-file=.env dist/worker.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo-account": "tsx --env-file=.env scripts/seed-demo-account.ts",
    "sync:demo-snapshot": "tsx --env-file=.env scripts/sync-demo-snapshot.ts",
    "smoke:docker": "bash scripts/smoke/docker-healthcheck.sh && bash scripts/smoke/smoke-api.sh && bash scripts/smoke/smoke-telemetry.sh && bash scripts/smoke/smoke-idempotency.sh && bash scripts/smoke/smoke-worker-restart.sh && bash scripts/smoke/smoke-redis-recovery.sh"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@google/genai": "^2.15.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "bullmq": "^6.1.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "papaparse": "^5.5.4",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
