+  return fetchWithCache(cacheKey, async () => {
+    const { data, error } = await supabase
+      .from('pm_vehicle_subscriptions')
+      .select('*')
+      .eq('tenant_id', tenantId);
+    
+    if (error) {
+      console.warn(`fetchPmSubscriptions: ${error.message}`);
+      return [];
+    }
+    return data || [];
+  });
+}
